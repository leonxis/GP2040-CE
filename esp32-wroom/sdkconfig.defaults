# ESP32-WROOM-32E BLE transmitter for wireless-tx-2354
# Target: classic ESP32, dual core, 4MB flash, 80MHz
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# CPU downclock (BLE baseband uses independent clock, unaffected)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Bluetooth: NimBLE peripheral-only, single connection, bond persistence
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_CTRL_MODEM_SLEEP=y

# esp-nimble-cpp wrapper
CONFIG_NIMBLE_CPP_LOG_LEVEL_WARNING=y

# UART0 is dedicated to the RP2354 link: no console on any UART
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARNING=y

# Larger app partition (BLE stack is sizeable)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# FreeRTOS: dual core, 1kHz tick, no power management/tickless
CONFIG_FREERTOS_HZ=1000

# Newlib nano keeps firmware smaller; nanosecond printf not needed
CONFIG_NEWLIB_NANO_FORMAT=y
