+Slider::Slider(const std::string &_title,
+               unsigned char _min,
+               unsigned char _max,
+               unsigned char _step,
+               unsigned char &_value) : refValue(_value) {
+  title = _title;
+  maxLength = 0;
+  min = _min;
+  max = _max;
+  step = _step;
+  value = _value;
+  lengthIndicator = 0;
+  this->parent = nullptr;
+
+  if (value > max) valueOverflow = true;
+  else valueOverflow = false;
+}
+
+unsigned char Slider::add() {
+  if (value + step > max) value = max;
+  else value = (unsigned char)(value + step);
+  valueOverflow = false;
+  refValue = value;
+  return this->value;
+}
+
+unsigned char Slider::sub() {
+  if (value < step) value = min;
+  else value = (unsigned char)(value - step);
+  valueOverflow = false;
+  refValue = value;
+  return this->value;
+}
+
+void Slider::init() {
+  maxLength = (unsigned char)std::floor(HAL::getSystemConfig().screenWeight * 0.35f);
+  if (max > min)
+    position.lTrg = (float)std::floor(((float)(value - min) / (float)(max - min)) * maxLength);
+  else
+    position.lTrg = 0;
+  lengthIndicator = 0;
+  if (valueOverflow) {
+    position.lTrg = maxLength;
+  }
+}
+
+void Slider::deInit() {
+  // 静态持有，不 delete this。
+}
+
+void Slider::renderIndicator(float _x, float _y, const std::vector<float> &_camera) {
+  Item::updateConfig();
+
+  if (max > min)
+    position.lTrg = (float)std::floor(((float)(value - min) / (float)(max - min)) * maxLength);
+  else
+    position.lTrg = 0;
+  if (valueOverflow) position.lTrg = maxLength;
+
+  Animation::move(&position.l, position.lTrg, astraConfig.listAnimationSpeed);
+
+  HAL::setDrawType(1);
+  // 槽框
+  HAL::drawRFrame(_x + _camera[0] - 1, _y + _camera[1] - 1, maxLength + 2, 6, 1);
+  // 填充
+  HAL::drawBox(_x + _camera[0], _y + _camera[1], position.l, 4);
+  // 数值文字
+  std::string num = std::to_string((int)value);
+  float nw = (float)HAL::getFontWidth(num);
+  HAL::drawEnglish(_x + _camera[0] + maxLength + 4,
+                   _y + _camera[1] + astraConfig.listTextHeight,
+                   num);
+}
