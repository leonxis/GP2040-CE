+  addPopUp(led, "颜色", opts(N_COLOR, 16), B.color,
+           []{ sColor(B.color); });
+  addSlider(led, "渐变速度", 1, 10, 1, B.gradSpd, []{ sGradientSpd(B.gradSpd); });
+  addSlider(led, "追逐速度", 0, 100, 1, B.chaseSpd, []{ sChaseSpd(B.chaseSpd); });
+  addSlider(led, "呼吸速度", 1, 10, 1, B.breathSpd, []{ sBreathSpd(B.breathSpd); });
+  addCheck(led, "挂起时关LED", B.ledOff, []{ sLedOff(B.ledOff ? 1 : 0); });
+}
+
+void AstraMenuScreen::destroyTree(astra::Menu* menu) {
+  if (!menu) return;
+  for (auto* w : menu->childWidget) delete w;
+  menu->childWidget.clear();
+  for (auto* c : menu->childMenu) destroyTree(c);
+  menu->childMenu.clear();
+  delete menu;
+}
+
+AstraMenuScreen::~AstraMenuScreen() {
+  if (launcher) {
+    delete launcher;
+    launcher = nullptr;
+  }
+  if (root) {
+    destroyTree(root);
+    root = nullptr;
+  }
+}
+
+// ===================== screen lifecycle =====================
+void AstraMenuScreen::init() {
+  HALPico& hal = HALPico::getInstance();
+  if (!HAL::check()) {
+    HAL::inject(&hal);
+  }
+  hal.begin(getRenderer());
+  refreshBacking();
+  buildTree();
+  launcher = new Launcher();
+  launcher->init(root);
+  // 初始化 B1 边沿状态：若进入菜单时 B1 正被按住，不立即触发退出
+  Gamepad* gp0 = Storage::getInstance().GetGamepad();
+  b1Prev = gp0 && (gp0->state.buttons & GAMEPAD_MASK_B1);
+}
+
+void AstraMenuScreen::shutdown() {
+  // 树与 launcher 在析构函数中销毁，shutdown 仅做状态收尾
+}
+
+int8_t AstraMenuScreen::update() {
+  if (!launcher) return -1;
+  launcher->inputStep();
+
+  // 根页 B1 按下沿 → 退出菜单
+  Gamepad* gp = Storage::getInstance().GetGamepad();
+  bool b1Now = gp && (gp->state.buttons & GAMEPAD_MASK_B1);
+  if (launcher->atRoot() && b1Now && !b1Prev) {
+    b1Prev = b1Now;
+    return (int8_t)DisplayMode::BUTTONS;
+  }
+  b1Prev = b1Now;
+  return -1;
+}
+
+void AstraMenuScreen::drawScreen() {
+  if (launcher) launcher->renderStep();
+}
