+static int gAmbientBright() {
+  int idx = (int)AOP().ambientLightEffectsCountIndex;
+  float b = 0.0f;
+  switch (idx) {
+    case 4: b = AOP().alStaticBrightnessCustomThemeX; break;
+    case 1: b = AOP().alGradientBrightnessCustomX; break;
+    case 2: b = AOP().alChaseBrightnessCustomX; break;
+    case 3: b = AOP().alBreathBrightnessCustomX; break;
+    default: b = 0.0f; break;
+  }
+  int v = (int)(b * 100.0f + 0.5f);
+  return v < 0 ? 0 : (v > 100 ? 100 : v);
+}
