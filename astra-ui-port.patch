+
+bool CheckBox::uncheck() {
+  value = 0;
+  isCheck = false;
+  refValue = false;
+  return isCheck;
+}
+
+bool CheckBox::toggle() {
+  value = !value;
+  isCheck = !isCheck;
+  refValue = isCheck;
