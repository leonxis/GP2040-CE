-static void backOne() {
-  if (inBackMap) {
-    inBackMap = false;
-    backMapDirty = false;
-    level = 2; sel = 0; scroll = 0;  // 保留 section（父级分区）
-    resetListAnim();
-    dirty = false;
-    return;
-  }
-  if (level == 2) {
-    LiteSection* secs = currentSections();
-    if (secs && page == 0) { level = 1; section = 0; sel = 0; scroll = 0; }
-    else { level = 0; section = 0; sel = 0; scroll = 0; }
-  } else {
-    level = 0; section = 0; sel = 0; scroll = 0;
-  }
-  resetListAnim();
-  dirty = false;
