+  this->childWidget.clear();
+  this->position = {};
+  this->positionForeground = {};
+}
+
+List::List(const std::string &_title, const std::vector<unsigned char> &_pic) {
+  this->title = _title;
+  this->pic = _pic;
+  this->selectIndex = 0;
