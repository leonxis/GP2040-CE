-static const char* HIST_NAMES[] = {
-    "U", "D", "L", "R",
-    "B1", "B2", "B3", "B4", "L1", "R1", "L2", "R2",
-    "S1", "S2", "L3", "R3", "A1", "A2", "A3", "A4",
-};
-static std::deque<std::string> histEntries;
-static uint32_t histLastMask = 0;
