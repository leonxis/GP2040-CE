diff --git a/src/display/hal_pico.cpp b/src/display/hal_pico.cpp
new file mode 100644
index 00000000..2bcd4cc2
--- /dev/null
+++ b/src/display/hal_pico.cpp
@@ -0,0 +1,293 @@
+#include "display/hal_pico.h"
+
+#include "GPGFX.h"
+#include "interfaces/i2c/ssd1306/tiny_ssd1306.h"
+#include "storagemanager.h"
+#include "GamepadState.h"
+#include "cn_font_lite.h"
+#include "fonts/GP_Font_Standard.h"
+#include "pico/stdlib.h"
+
+#include <cmath>
+#include <cstring>
+
+HALPico& HALPico::getInstance() {
+  static HALPico instance;
+  return instance;
+}
+
+void HALPico::begin(GPGFX* gfx) {
+  if (gfx && gfx->getDriver()) {
+    auto* drv = static_cast<GPGFX_TinySSD1306*>(gfx->getDriver());
+    if (drv) fb = drv->getFrameBuffer();
+  }
+}
+
+void* HALPico::_getCanvasBuffer() { return fb; }
+unsigned char HALPico::_getBufferTileWidth() { return 16; }
+unsigned char HALPico::_getBufferTileHeight() { return 8; }
+
+void HALPico::_canvasClear() {
+  if (fb) memset(fb, 0, 1024);
+}
+
+void HALPico::applyPx(int x, int y) {
+  if (!fb || x < 0 || x >= 128 || y < 0 || y >= 64) return;
+  uint8_t mask = (uint8_t)(1 << (y & 7));
+  uint16_t idx = (uint16_t)((y >> 3) * 128 + x);
+  switch (drawType) {
+    case 0: fb[idx] &= ~mask; break;
+    case 1: fb[idx] |= mask; break;
+    case 2: fb[idx] ^= mask; break;
+    default: break;
+  }
+}
+
+void HALPico::_drawPixel(float _x, float _y) {
+  applyPx((int)roundf(_x), (int)roundf(_y));
+}
+
+void HALPico::_drawHLine(float _x, float _y, float _l) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int l = (int)roundf(_l);
+  if (l < 0) { x += l; l = -l; }
+  for (int i = 0; i < l; i++) applyPx(x + i, y);
+}
+
+void HALPico::_drawVLine(float _x, float _y, float _h) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int h = (int)roundf(_h);
+  if (h < 0) { y += h; h = -h; }
+  for (int i = 0; i < h; i++) applyPx(x, y + i);
+}
+
+void HALPico::_drawHDottedLine(float _x, float _y, float _l) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int l = (int)roundf(_l);
+  // 5 实 3 空
+  for (int i = 0; i < l; i++) {
+    if ((i % 8) < 5) applyPx(x + i, y);
+  }
+}
+
+void HALPico::_drawVDottedLine(float _x, float _y, float _h) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int h = (int)roundf(_h);
+  for (int i = 0; i < h; i++) {
+    if ((i % 8) < 5) applyPx(x, y + i);
+  }
+}
+
+void HALPico::_drawBox(float _x, float _y, float _w, float _h) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int w = (int)roundf(_w), h = (int)roundf(_h);
+  if (w < 0) { x += w; w = -w; }
+  if (h < 0) { y += h; h = -h; }
+  for (int yy = 0; yy < h; yy++)
+    for (int xx = 0; xx < w; xx++)
+      applyPx(x + xx, y + yy);
+}
+
+void HALPico::_drawFrame(float _x, float _y, float _w, float _h) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int w = (int)roundf(_w), h = (int)roundf(_h);
+  if (w <= 0 || h <= 0) return;
+  _drawHLine(x, y, w);
+  _drawHLine(x, y + h - 1, w);
+  _drawVLine(x, y, h);
+  _drawVLine(x + w - 1, y, h);
+}
+
+static bool inRoundedRect(int xx, int yy, int w, int h, int r) {
+  if (r <= 0) return true;
+  int dx = 0, dy = 0;
+  if (xx < r) dx = r - xx;
+  else if (xx >= w - r) dx = xx - (w - r - 1);
+  if (yy < r) dy = r - yy;
+  else if (yy >= h - r) dy = yy - (h - r - 1);
+  if (dx == 0 || dy == 0) return true;
+  return dx * dx + dy * dy <= r * r;
+}
+
+void HALPico::_drawRBox(float _x, float _y, float _w, float _h, float _r) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int w = (int)roundf(_w), h = (int)roundf(_h);
+  int r = (int)roundf(_r);
+  if (w <= 0 || h <= 0) return;
+  int maxr = (w < h ? w : h) / 2;
+  if (r > maxr) r = maxr;
+  for (int yy = 0; yy < h; yy++)
+    for (int xx = 0; xx < w; xx++)
+      if (inRoundedRect(xx, yy, w, h, r)) applyPx(x + xx, y + yy);
+}
+
+void HALPico::_drawRFrame(float _x, float _y, float _w, float _h, float _r) {
+  int x = (int)roundf(_x), y = (int)roundf(_y);
+  int w = (int)roundf(_w), h = (int)roundf(_h);
+  int r = (int)roundf(_r);
+  if (w <= 0 || h <= 0) return;
+  int maxr = (w < h ? w : h) / 2;
+  if (r > maxr) r = maxr;
+  for (int yy = 0; yy < h; yy++) {
+    for (int xx = 0; xx < w; xx++) {
+      if (!inRoundedRect(xx, yy, w, h, r)) continue;
+      bool edge = !inRoundedRect(xx + 1, yy, w, h, r) ||
+                  !inRoundedRect(xx - 1, yy, w, h, r) ||
+                  !inRoundedRect(xx, yy + 1, w, h, r) ||
+                  !inRoundedRect(xx, yy - 1, w, h, r);
+      if (edge) applyPx(x + xx, y + yy);
+    }
+  }
+}
+
+void HALPico::_drawBMP(float _x, float _y, float _w, float _h, const unsigned char *_bitMap) {
+  if (!_bitMap) return;
+  int x0 = (int)roundf(_x), y0 = (int)roundf(_y);
+  int w = (int)roundf(_w), h = (int)roundf(_h);
+  int rowBytes = (w + 7) / 8;
+  for (int py = 0; py < h; py++) {
+    for (int px = 0; px < w; px++) {
+      uint8_t b = _bitMap[py * rowBytes + px / 8];
+      if (b & (0x80 >> (px & 7))) applyPx(x0 + px, y0 + py);
+    }
+  }
+}
+
+// ---- 文字 ----
+static int findCJK(uint16_t cp) {
+  int lo = 0, hi = CN_FONT_NUM - 1;
+  while (lo <= hi) {
+    int mid = (lo + hi) / 2;
+    if (CN_FONT_CODES[mid] == cp) return mid;
+    if (CN_FONT_CODES[mid] < cp) lo = mid + 1; else hi = mid - 1;
+  }
+  return -1;
+}
+
+static void drawCJKPx(int x, int y, uint16_t cp) {
+  int idx = findCJK(cp);
+  if (idx < 0) return;
+  const uint8_t* g = CN_FONT_GLYPHS[idx];
+  for (int row = 0; row < CN_FONT_SIZE; row++) {
+    uint16_t bits = ((uint16_t)g[row * 2] << 8) | g[row * 2 + 1];
+    for (int col = 0; col < CN_FONT_SIZE; col++) {
+      if (bits & (0x8000 >> col)) {
+        // 直接写帧缓冲（与 applyPx 同布局），避免虚函数开销
+        HALPico::getInstance()._drawPixel((float)(x + col), (float)(y + row));
+      }
+    }
+  }
+}
+
+static void drawAsciiPx(int x, int y, uint8_t c) {
+  if (c >= GPGFX_FONT_CHAR_OFFSET && c < GPGFX_FONT_CHAR_OFFSET + 96) {
+    const uint8_t* g = &GP_Font_Standard[(c - GPGFX_FONT_CHAR_OFFSET) * 5];
+    for (int col = 0; col < 5; col++) {
+      uint8_t byte = g[col];
+      for (int row = 0; row < 8; row++) {
+        if (byte & (1 << row)) HALPico::getInstance()._drawPixel((float)(x + col), (float)(y + row));
+      }
+    }
+  }
+}
+
+void HALPico::drawMixed(float _x, float _y, const std::string &_text) {
+  int x = (int)roundf(_x);
+  int yBase = (int)roundf(_y);
+  const char* s = _text.c_str();
+  while (*s) {
+    uint8_t c = (uint8_t)*s;
+    if (c < 0x80) {
+      drawAsciiPx(x, yBase - 8, c);
+      x += 6;
+      s++;
+    } else {
+      uint16_t cp = 0;
+      int len = 0;
+      if ((c & 0xE0) == 0xC0) { cp = (uint16_t)(c & 0x1F) << 6; len = 2; }
+      else if ((c & 0xF0) == 0xE0) { cp = (uint16_t)(c & 0x0F) << 12; len = 3; }
+      else { s++; continue; }
+      s++;
+      for (int i = 1; i < len; i++) {
+        if (!*s) break;
+        cp = (cp << 6) | (uint16_t)((uint8_t)*s & 0x3F);
+        s++;
+      }
+      drawCJKPx(x, yBase - 12, cp);
+      x += CN_FONT_SIZE;
+    }
+  }
+}
+
+void HALPico::_drawEnglish(float _x, float _y, const std::string &_text) { drawMixed(_x, _y, _text); }
+void HALPico::_drawChinese(float _x, float _y, const std::string &_text) { drawMixed(_x, _y, _text); }
+
+unsigned char HALPico::_getFontWidth(std::string &_text) {
+  int w = 0;
+  const char* s = _text.c_str();
+  while (*s) {
+    uint8_t c = (uint8_t)*s;
+    if (c < 0x80) { w += 6; s++; }
+    else if ((c & 0xE0) == 0xC0) { w += 12; s += 2; }
+    else if ((c & 0xF0) == 0xE0) { w += 12; s += 3; }
+    else s++;
+  }
+  return (unsigned char)w;
+}
+
+unsigned long HALPico::_millis() { return (unsigned long)getMillis(); }
+void HALPico::_delay(unsigned long _mill) { busy_wait_ms(_mill); }
+
+// ---- 按键 ----
+void HALPico::_keyScan() {
+  Gamepad* gamepad = Storage::getInstance().GetGamepad();
+  if (!gamepad) return;
+
+  static struct {
+    bool last;
+    uint32_t t;
+    bool rep;
+  } st[6] = {};
+
+  uint8_t dpad = gamepad->state.dpadOriginal;
+  uint32_t buttons = gamepad->state.buttons;
+
+  bool pressed[6];
+  pressed[0] = (dpad & 0x01) != 0;  // UP
+  pressed[1] = (dpad & 0x02) != 0;  // DOWN
+  pressed[2] = (dpad & 0x04) != 0;  // LEFT
+  pressed[3] = (dpad & 0x08) != 0;  // RIGHT
+  pressed[4] = (buttons & GAMEPAD_MASK_B1) != 0;
+  pressed[5] = (buttons & GAMEPAD_MASK_B2) != 0;
+
+  uint32_t now = getMillis();
+
+  for (int i = 0; i < 6; i++) {
+    if (pressed[i] && !st[i].last) {
+      key[i] = key::CLICK;
+      keyFlag = key::KEY_PRESSED;
+      st[i].t = now;
+      st[i].rep = false;
+    } else if (pressed[i]) {
+      // B1/B2 不连发
+      if (i >= 4) { st[i].last = pressed[i]; continue; }
+      if (!st[i].rep) {
+        if (now - st[i].t >= 420) {
+          key[i] = key::CLICK;
+          keyFlag = key::KEY_PRESSED;
+          st[i].t = now;
+          st[i].rep = true;
+        }
+      } else {
+        if (now - st[i].t >= 160) {
+          key[i] = key::CLICK;
+          keyFlag = key::KEY_PRESSED;
+          st[i].t = now;
+        }
+      }
+    } else {
+      st[i].rep = false;
+    }
+    st[i].last = pressed[i];
+  }
+}
