+//
+// Created by Fir on 2024/2/8.
+// 移植版：按键扩为 6 键（上下左右 + B1/B2）。
+
+#pragma once
+#ifndef ASTRA_CORE_SRC_HAL_HAL_H_
+#define ASTRA_CORE_SRC_HAL_HAL_H_
+
+#include <string>
+#include <utility>
+#include <array>
+#include <vector>
+#include "astra/config.h"
+
+namespace oled {
+
+}
+
+namespace key {
+typedef enum keyFilter {
+  CHECKING = 0,
+  KEY_0_CONFIRM,
+  KEY_1_CONFIRM,
+  RELEASED,
+} KEY_FILTER;
+
+typedef enum keyAction {
+  INVALID = 0,
+  CLICK,
+  PRESS,
+} KEY_ACTION;
+
+typedef enum KeyType {
+  KEY_NOT_PRESSED = 0,
+  KEY_PRESSED,
+} KEY_TYPE;
+
+typedef enum keyIndex {
+  KEY_UP = 0,
+  KEY_DOWN,
+  KEY_LEFT,
+  KEY_RIGHT,
+  KEY_B1,
+  KEY_B2,
+  KEY_NUM,
+} KEY_INDEX;
+}
+
