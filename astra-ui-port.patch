diff --git a/lib/AstraUI/src/launcher.cpp b/lib/AstraUI/src/launcher.cpp
new file mode 100644
index 00000000..8022ec70
--- /dev/null
+++ b/lib/AstraUI/src/launcher.cpp
@@ -0,0 +1,177 @@
+//
+// Created by Fir on 2024/2/2.
+// 移植版：非阻塞 toast、6 键路由、ActionItem、input/render 拆分。
+
+#include "astra/launcher.h"
+#include "astra/action_item.h"
+
+namespace astra {
+
+void Launcher::popInfo(std::string _info, uint16_t _time) {
+  popMsg = std::move(_info);
+  popDuration = _time;
+  popStartTime = HAL::millis();
+  popActive = true;
+  popExiting = false;
+
+  float hPop = (float)HAL::getFontHeight() + 2 * getUIConfig().popMargin;
+  popY = 0 - hPop - 8;
+  popYTrg = (HAL::getSystemConfig().screenHeight - hPop) / 3;
+}
+
+void Launcher::init(Menu *_rootPage) {
+  currentMenu = _rootPage;
+  rootMenu = _rootPage;
+
+  camera = new Camera(0, 0);
+  _rootPage->childPosInit(camera->getPosition());
+
+  selector = new Selector();
+  selector->inject(_rootPage);
+
+  camera->init(_rootPage->getType());
+}
+
+Launcher::~Launcher() {
+  delete camera;
+  delete selector;
+  camera = nullptr;
+  selector = nullptr;
+}
+
+bool Launcher::open() {
+  Menu *next = currentMenu->getNextMenu();
+  if (next == nullptr) return false;
+  // ActionItem 不进入子页
+  if (next->getType() == "Action") return false;
+
+  currentMenu->rememberCameraPos(camera->getPositionTrg());
+  currentMenu = next;
+  currentMenu->forePosInit();
+  currentMenu->childPosInit(camera->getPosition());
+
+  selector->inject(currentMenu);
+
+  return true;
+}
+
+bool Launcher::close() {
+  if (currentMenu->getPreview() == nullptr) return false;
+
+  currentMenu->rememberCameraPos(camera->getPositionTrg());
+  currentMenu = currentMenu->getPreview();
+  currentMenu->forePosInit();
+  currentMenu->childPosInit(camera->getPosition());
+
+  selector->inject(currentMenu);
+
+  return true;
+}
+
+bool Launcher::atRoot() {
+  return currentMenu == rootMenu;
+}
+
+void Launcher::inputStep() {
+  HAL::keyScan();
+
+  if (*HAL::getKeyFlag() != key::KEY_PRESSED) return;
+  *HAL::getKeyFlag() = key::KEY_NOT_PRESSED;
+
+  auto *km = HAL::getKeyMap();
+
+  for (unsigned char i = 0; i < key::KEY_NUM; i++) {
+    if (km[i] != key::CLICK) continue;
+
+    switch (i) {
+      case key::KEY_UP:
+        selector->goPreview();
+        break;
+      case key::KEY_DOWN:
+        selector->goNext();
+        break;
+      case key::KEY_LEFT:
+        if (currentMenu->getType() == "Tile") {
+          selector->goPreview();
+        } else {
+          Menu *item = currentMenu->getNextMenu();
+          if (item && !item->childWidget.empty()) {
+            Widget *w = item->childWidget[0];
+            std::string wt = w->getType();
+            if (wt == "CheckBox") static_cast<CheckBox*>(w)->toggle();
+            else if (wt == "PopUp") static_cast<PopUp*>(w)->selectPreview();
+            else if (wt == "Slider") static_cast<Slider*>(w)->sub();
+            if (item->sync) item->sync();
+          }
+        }
+        break;
+      case key::KEY_RIGHT:
+        if (currentMenu->getType() == "Tile") {
+          selector->goNext();
+        } else {
+          Menu *item = currentMenu->getNextMenu();
+          if (item && !item->childWidget.empty()) {
+            Widget *w = item->childWidget[0];
+            std::string wt = w->getType();
+            if (wt == "CheckBox") static_cast<CheckBox*>(w)->toggle();
+            else if (wt == "PopUp") static_cast<PopUp*>(w)->selectNext();
+            else if (wt == "Slider") static_cast<Slider*>(w)->add();
+            if (item->sync) item->sync();
+          }
+        }
+        break;
+      case key::KEY_B2: {
+        Menu *item = currentMenu->getNextMenu();
+        if (item == nullptr) break;
+        if (item->getType() == "Action") {
+          auto *act = static_cast<ActionItem*>(item);
+          act->run();
+          if (!act->getInfo().empty()) popInfo(act->getInfo(), 900);
+        } else {
+          open();
+        }
+        break;
+      }
+      case key::KEY_B1:
+        close();
+        break;
+      default: break;
+    }
+  }
+
+  std::fill(HAL::getKeyMap(), HAL::getKeyMap() + key::KEY_NUM, key::INVALID);
+  *HAL::getKeyFlag() = key::KEY_NOT_PRESSED;
+}
+
+void Launcher::renderStep() {
+  currentMenu->render(camera->getPosition());
+  selector->render(camera->getPosition());
+  camera->update(currentMenu, selector);
+
+  // 非阻塞 toast 叠加
+  if (popActive) {
+    float hPop = (float)HAL::getFontHeight() + 2 * getUIConfig().popMargin;
+    float wPop = (float)HAL::getFontWidth(popMsg) + 2 * getUIConfig().popMargin;
+    float xPop = (HAL::getSystemConfig().screenWeight - wPop) / 2;
+
+    if (!popExiting && HAL::millis() - popStartTime >= popDuration) {
+      popExiting = true;
+      popYTrg = 0 - hPop - 8;
+    }
+
+    Animation::move(&popY, popYTrg, getUIConfig().popSpeed);
+
+    HAL::setDrawType(0);
+    HAL::drawRBox(xPop - 4, popY - 4, wPop + 8, hPop + 8, getUIConfig().popRadius + 2);
+    HAL::setDrawType(1);
+    HAL::drawRFrame(xPop - 1, popY - 1, wPop + 2, hPop + 2, getUIConfig().popRadius);
+    HAL::drawEnglish(xPop + getUIConfig().popMargin,
+                     popY + getUIConfig().popMargin + HAL::getFontHeight(),
+                     popMsg);
+
+    if (popExiting && popY == 0 - hPop - 8) {
+      popActive = false;
+    }
+  }
+}
+}
