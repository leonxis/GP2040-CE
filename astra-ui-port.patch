+#pragma once
+#ifndef ASTRA_ACTION_ITEM__H
+#define ASTRA_ACTION_ITEM__H
+
+#include <functional>
+#include <string>
+#include "astra/menu.h"
+
+namespace astra {
+
+// 即时动作项：作为叶子挂在 childMenu 中，选中后按 B2 直接执行回调，不进入子页面。
+class ActionItem : public Menu {
+public:
+  [[nodiscard]] std::string getType() const override { return "Action"; }
+
+  std::string info;  // 执行后弹出的 toast 文案（可空）
+
+  ActionItem(const std::string &_title, std::function<void()> _fn, std::string _info = "")
+      : info(std::move(_info)), fn(std::move(_fn)) {
+    title = _title;
+    pic = generateDefaultPic();
+    selectIndex = 0;
+    parent = nullptr;
+  }
+
+  void run() {
+    if (fn) fn();
+  }
+
+  [[nodiscard]] const std::string &getInfo() const { return info; }
+
+private:
+  std::function<void()> fn;
+};
+
+}
+
+#endif //ASTRA_ACTION_ITEM__H
